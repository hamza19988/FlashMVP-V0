# ── Execution mode ─────────────────────────────────────────────
# true  = mock engine (no Docker / DB / IBM calls) – default for local dev & Vercel demo
# false = real engine (Docker, Supabase/IBM Cloud DB, cloudflared, IBM Bob API)
DEMO_MODE=true

# ── API ────────────────────────────────────────────────────────
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── IBM Bob 2.0 (Person 3) ─────────────────────────────────────
IBM_BOB_API_URL=
IBM_BOB_API_KEY=

# ── IBM watsonx (Person 3) ─────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Database: IBM Cloud DB / Supabase Postgres (Person 4) ─────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── Secrets vault (Person 4) ───────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

# ── Container runner (Person 4) ────────────────────────────────
WORKSPACE_DIR=/tmp/flashmvp
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8001
CLOUDFLARED_BIN=cloudflared
