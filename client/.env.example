# true  = UI runs fully on local fixtures (no backend needed) - used on Vercel 24/7
# false = UI calls the FastAPI server through the Vite /api proxy
VITE_DEMO_MODE=true

# Only needed when the API is on another origin (e.g. a deployed backend).
# Leave empty in local dev: Vite proxies /api to http://localhost:8000.
VITE_API_BASE_URL=
